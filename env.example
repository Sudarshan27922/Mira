# Pinecone Configuration (Required)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=mira-policy-documents

# Google AI Configuration (Required for main agent)
GOOGLE_API_KEY=your_google_api_key_here

# Public Webhook URL (Required for button clicks)
# Set this to your ngrok URL or public server URL
PUBLIC_WEBHOOK_URL=https://your-ngrok-url.ngrok.io

# Calendar Configuration
USE_DOMAIN_DELEGATION=true  # Set to false for individual calendar sharing

# Note: If your organization only allows "See only free/busy" calendar sharing:
# The system will automatically use freebusy queries when full access is unavailable.
# You'll still get conflict detection, just without meeting titles/details.

# Optional Pinecone Settings (defaults will be used if not set)
# PINECONE_ENVIRONMENT=gcp-starter
# PINECONE_DIMENSION=384
# PINECONE_METRIC=cosine
