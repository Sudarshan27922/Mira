# Pinecone Configuration (Required)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=mira-policy-documents

# Google AI Configuration (Required for main agent)
GOOGLE_API_KEY=your_google_api_key_here

# Calendar Configuration
USE_DOMAIN_DELEGATION=true  # Set to false for individual calendar sharing

